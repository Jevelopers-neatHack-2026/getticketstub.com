# Copy to .env.local. Secrets stay server-side; never use NEXT_PUBLIC_ names.
# Demo preview is the default and does not call providers even with keys present.
TICKETSTUB_RUNTIME_MODE=demo

# Select each capability independently: anthropic/openrouter for research and
# agent; openai/openrouter for art. The default is the original direct provider.
TICKETSTUB_RESEARCH_PROVIDER=anthropic
TICKETSTUB_AGENT_PROVIDER=anthropic
TICKETSTUB_ART_PROVIDER=openai

# Required only when that capability selects openrouter. Choose exact model IDs
# from https://openrouter.ai/models (no auto/online/fallback variants).
TICKETSTUB_RESEARCH_MODEL=
TICKETSTUB_AGENT_MODEL=
TICKETSTUB_ART_MODEL=
# Each selected model uses its own key. There is no shared-key fallback.
TICKETSTUB_RESEARCH_OPENROUTER_API_KEY=
TICKETSTUB_AGENT_OPENROUTER_API_KEY=
TICKETSTUB_ART_OPENROUTER_API_KEY=

# Required only for selected direct-provider paths.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Open-Meteo API Standard subscription key (dashboard.open-meteo.com), server secret only. Set = weather and
# place lookups use the commercial customer endpoints; blank = the free tier, which is for evaluation only and
# not licensed for commercial use. The plan has no historical weather: dates more than 92 days back stay pending.
OPEN_METEO_API_KEY=

# Product analytics (GA4, docs/operations/analytics.md). Off unless BOTH are set, and nothing loads in
# a browser until the visitor agrees. Read per request by the server: change and restart, no rebuild.
# The measurement id is public page configuration, not a secret. Give preview its own GA4 property.
# production | preview
TICKETSTUB_ANALYTICS_ENV=
# G-XXXXXXXXXX from the property's web data stream
TICKETSTUB_GA_MEASUREMENT_ID=
# 1 = mark events for GA DebugView (designated test property only)
TICKETSTUB_GA_DEBUG=
# 1 = kill switch: no consent card, no script, no events, whatever else is set
TICKETSTUB_ANALYTICS_DISABLED=

# Server operational measurement (separate from browser analytics consent). Default off.
# off | log | neatlogs | log,neatlogs   (log = one sanitized JSON line per event on stdout, schema ticketstub.ops/1;
# neatlogs = one content-free Neatlogs trace per AI route request, needs NEATLOGS_INGEST_KEY)
TICKETSTUB_OPS_TELEMETRY=off
# Neatlogs project API key (Settings > API keys), server secret only. Sent only as x-api-key to the ingest origin.
NEATLOGS_INGEST_KEY=
# (Formerly NEATLOGS_API_KEY / NEATLOGS_TOKEN; the old names are still read as fallbacks while hosts rename them.)
# Blank = US https://ingest.neatlogs.com; EU projects use https://eu.ingest.neatlogs.com
NEATLOGS_ENDPOINT=
# Optional short or full commit SHA of the deployed build, added as a ticketstub@<sha> trace tag
TICKETSTUB_COMMIT_SHA=
# production | preview | development | test — labels events so preview/demo traffic is never read as production
TICKETSTUB_OPS_ENVIRONMENT=

# Agent-harness hand-off of product events (docs/architecture/events.md#harness-hand-off). Default off.
# off | neatlogs  (neatlogs = each ticketstub.event/1 event is stored in the harness outbox and delivered as a
# Neatlogs trace by a background drain; needs AGENT_HARNESS_TELEMETRY_KEY and NEATLOGS_INGEST_KEY)
TICKETSTUB_HARNESS_EXPORT=off
# Server secret: 64 lowercase hex characters (`openssl rand -hex 32`). HMAC key that turns request ids and refs into
# tokens before anything leaves the server. Changing it starts new Neatlogs sessions.
AGENT_HARNESS_TELEMETRY_KEY=
# Optional: Neatlogs service-account token (observability:read) and its project UUID. With both, the server reads
# each trace back, settles it as verified, and re-sends one that never appears. Without them traces stay "sent".
NEATLOGS_READ_TOKEN=
NEATLOGS_PROJECT_ID=
# Optional outbox file; default agent-harness-outbox.sqlite next to TICKETSTUB_DB (must be durable and private).
TICKETSTUB_HARNESS_DB=

# Staff access: comma-separated verified account emails that get /admin and POST /api/admin/backup.
ADMIN_EMAILS=
# Signs 5-minute context tokens (HMAC-SHA256), 32+ characters, e.g. `openssl rand -hex 32`.
# Required in live mode (otherwise /api/context answers 503). Never the fixture key in fixtures/context.
CONTEXT_SECRET=
# Context tokens only (decision 0003 K4): other token classes have their own key sets below.
# APPROVAL_SIGNING_KEYS: artwork approval tokens. Versioned JSON, one line, exactly one active key:
#   {"v":1,"keys":[{"kid":"approval-g1","state":"active","activatedAt":"<ISO time>","key":"<base64url of 32 random bytes>"}]}
# Generate each key: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotate by adding the new key as active and marking the old one retired; set both timestamps to when
# the restarted server is live (at most 5 minutes ahead). Keep the retired entry for 7 days + 5 minutes.
# Never reuse CONTEXT_SECRET or any other secret's value. Unset in live mode: approvals answer 503.
APPROVAL_SIGNING_KEYS=
# ORDER_AUTH_SIGNING_KEYS: order-authorization tokens. Same JSON shape, its own keys (kid e.g. order-auth-g1).
# Rotate as above; keep the retired entry for 20 minutes (15-minute token lifetime + 5 minutes) after its
# retiredAt. Never reuse another secret's value. Unset in live mode: issuing answers 503.
ORDER_AUTH_SIGNING_KEYS=
# ORDER_AUTH_CONSUMER_KEY: signs consumer requests to /api/order-authorizations/* only, never tokens.
# 32+ random characters, different from every key above. Unset: the consumer port answers 503.
ORDER_AUTH_CONSUMER_KEY=
# Days between automatic backups to <db folder>/backups (default 7; 0 or off disables). Needs TICKETSTUB_DB and TICKETSTUB_FILES.
TICKETSTUB_BACKUP_EVERY_DAYS=

# Dodo Payments (hackathon payments partner): hosted checkout for all-digital card/wallet orders only. Dodo is a
# merchant of record for digital goods and prohibits physical goods; orders with a card, print or framed line go to
# Stripe below. Payments are on only when all four are set. The environment is required: Dodo's own
# default is live, so an unset or unknown value turns payments off. Webhook endpoint: /api/payments/dodo/webhook.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# A one-time, pay-what-you-want USD product (digital_products); each checkout charges the server-verified total.
DODO_PAYMENTS_PRODUCT_ID=
# test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=

# Stripe (#64): hosted Checkout (Link and cards, from the account's payment method settings) for card/wallet orders
# with a physical line, once their variants are orderable (a confirmed printer SKU). Today every physical variant is
# a preview, so these stay sandbox. On only with both values. Test or live follows the secret key (sk_test_/sk_live_).
# Webhook endpoint: /api/payments/stripe/webhook (events: checkout.session.completed, .async_payment_succeeded,
# .async_payment_failed, .expired). Stripe collects the US shipping address; the app never stores it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
